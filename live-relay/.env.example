# ---- Required ---------------------------------------------------------------
# Shared with the Next.js app (same value as LIVE_RELAY_SECRET there). 32+ random chars:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
LIVE_RELAY_SECRET=

# ---- Google backend (pick ONE) ---------------------------------------------
# A) Gemini Enterprise Agent Platform / Vertex (where Live Avatar is documented as available)
#    Auth: `gcloud auth application-default login` locally, or a service account on Cloud Run.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=europe-west4
# B) Gemini API key (AI Studio) — avatar may not be enabled on this backend
# GEMINI_API_KEY=

# ---- Model / avatar ---------------------------------------------------------
GEMINI_LIVE_MODEL=gemini-3.8-live
# Preset avatar id (see the "Configure live avatars" doc / Studio for the list)
AVATAR_NAME=Kai
# Custom avatar (allowlisted projects only): portrait 9:16, >= 704x1280, jpg/png
# AVATAR_IMAGE_PATH=./echo-portrait.png
# AVATAR_ENABLED=false            # voice-only Gemini, no face
# AVATAR_VIDEO_BITRATE_BPS=600000 # lower = less data, softer picture
# GEMINI_VOICE_NAME=              # prebuilt voice name, if you want to pin one
# SPEECH_LANGUAGE_CODES=af:af-ZA,zu:zu-ZA   # only if auto language detection misbehaves

# ---- Limits / ops -----------------------------------------------------------
PORT=8787
MAX_SESSION_MINUTES=15
MAX_CONCURRENT_SESSIONS=3
# Comma-separated browser origins allowed to connect (empty = any)
ALLOWED_ORIGINS=http://localhost:3000,https://cu3e-hazel.vercel.app
# RELAY_DEBUG=true                # log every Gemini message shape
